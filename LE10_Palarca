#include <stdio.h>
#include <string.h>

int main() {
    FILE *file;
    char note[256];
    int n, i, ch;

    file = fopen("notes.txt", "w");

    if (file == NULL) {
        printf("Error creating file.\n");
        return 1;
    }

    printf("Writing Notes File:\n");
    printf("How many notes do you want to record? ");
    scanf("%d", &n);
    getchar();

    for (i = 1; i <= n; i++) {
        printf("Note %d: ", i);

        fgets(note, sizeof(note), stdin);
        
        if (strchr(note, '\n') == NULL) {
            while ((ch = getchar()) != '\n' && ch != EOF);
        }

        note[strcspn(note, "\n")] = '\0';

        fprintf(file, "%s\n", note);
    }

    fclose(file);

    printf("\nInitial notes saved successfully.\n\n");

    file = fopen("notes.txt", "a");

    if (file == NULL) {
        printf("Error opening file.\n");
        return 1;
    }

    printf("Enter one additional note:\n");

    fgets(note, sizeof(note), stdin);

    if (strchr(note, '\n') == NULL) {
        while ((ch = getchar()) != '\n' && ch != EOF);
    }

    note[strcspn(note, "\n")] = '\0';

    fprintf(file, "%s\n", note);

    fclose(file);

    printf("\nNew note added successfully.\n\n");


    file = fopen("notes.txt", "r");

    if (file == NULL) {
        printf("Error reading file.\n");
        return 1;
    }

    printf("Reading Saved Notes:\n");

    i = 1;

    while (fgets(note, sizeof(note), file) != NULL) {
        printf("%d. %s", i, note);

        if (strchr(note, '\n') == NULL) {
            printf("\n");
        }

        i++;
    }

    fclose(file);

    return 0;
}
