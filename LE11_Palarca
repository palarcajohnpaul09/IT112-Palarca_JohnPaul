#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    FILE *fp;
    char idNumber[30];
    char completeName[100];
    char section[30];
    char choice[10];

    fp = fopen("student_records.txt", "a");

    if (fp == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    do {
        printf("Enter Student Number: ");
        fgets(idNumber, sizeof(idNumber), stdin);
        idNumber[strcspn(idNumber, "\n")] = '\0';

        printf("Enter Complete Name: ");
        fgets(completeName, sizeof(completeName), stdin);
        completeName[strcspn(completeName, "\n")] = '\0';

        printf("Enter Section: ");
        fgets(section, sizeof(section), stdin);
        section[strcspn(section, "\n")] = '\0';

        fprintf(fp, "ID Number: %s\n", idNumber);
        fprintf(fp, "Complete Name: %s\n", completeName);
        fprintf(fp, "Section: %s\n\n", section);

        printf("\nRecord added and saved successfully.\n");

        printf("\nAdd another student? [Enter 1 for Yes, 0 for No]: ");
        fgets(choice, sizeof(choice), stdin);

    } while (atoi(choice) == 1);

    fclose(fp);

    printf("\nAll student records have been saved.\n");

    
    fp = fopen("student_records.txt", "r");

    if (fp == NULL) {
        printf("Error reading file!\n");
        return 1;
    }

    printf("\n===== STUDENT RECORDS =====\n\n");

    char line[200];

    while (fgets(line, sizeof(line), fp) != NULL) {
        printf("%s", line);
    }

    fclose(fp);

    return 0;
}
